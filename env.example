# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Template de variáveis de ambiente
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o arquivo .env — ele está no .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Banco de dados fonte (PostgreSQL transacional) ────────────────────────────
SOURCE_DATABASE_URL=postgresql://usuario:senha@host:5432/nome_banco

# ── Data Warehouse (Amazon Redshift) ─────────────────────────────────────────
# Opção 1 — URL completa (usada no Airflow Variable REDSHIFT_DATABASE_URL)
REDSHIFT_DATABASE_URL=postgresql://usuario:senha@host:5439/vendas_dw

# Opção 2 — Variáveis separadas (usadas no notebook analise.ipynb)
REDSHIFT_USER=usuario
REDSHIFT_PASSWORD=senha
REDSHIFT_HOST=seu-cluster.redshift.amazonaws.com
REDSHIFT_PORT=5439
REDSHIFT_DB=vendas_dw
REDSHIFT_SSLMODE=require

# ── Data Mart (PostgreSQL painel) ─────────────────────────────────────────────
DASHBOARD_DATABASE_URL=postgresql://usuario:senha@host:5432/dashboard

# ── HDFS ──────────────────────────────────────────────────────────────────────
HDFS_URL=http://hadoop:9870
HDFS_USER=root
HDFS_DEST_PATH=/vendas/fato_vendas/

# ── Data Lake local (pasta ignorada pelo Git via lake/ no .gitignore) ─────────
LOCAL_PARQUET_FOLDER=lake/fato_venda

# ── Agregação do Data Mart (anos separados por vírgula) ──────────────────────
AGGREGATION_YEARS=2024,2025,2026

# ── Dashboard Dash ────────────────────────────────────────────────────────────
DASH_PORT=8050
DASH_HOST=0.0.0.0
DASH_DEBUG=false
